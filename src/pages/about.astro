---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en" data-theme="garden">
	<head><BaseHead title={`Our story · ${SITE_TITLE}`} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main class="about-page">
			<p class="eyebrow">A note from us</p>
			<h1>Our story is still unfolding.</h1>
			<div class="prose">
				<p>
					We’re Cakey and Cynthia. This little journal is a place for the moments we want to hold on to
					as we make our way toward marriage: the milestones, the everyday joys, and the people who make
					our life feel like home.
				</p>
				<p>
					We’ll add to this page as our story grows. For now, we’re glad you’re here.
				</p>
				<a href="/blog/">Come read along <span aria-hidden="true">→</span></a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-page { max-width: 780px; padding-top: clamp(4rem, 10vw, 8rem); padding-bottom: 8rem; }
	.eyebrow { color: var(--accent); font-size: .78rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
	h1 { margin: 0 0 2rem; font-family: var(--font-serif); font-size: clamp(3rem, 8vw, 5.5rem); font-weight: 500; letter-spacing: -.05em; line-height: 1; }
	.prose { max-width: 620px; font-size: 1.15rem; }
	.prose a { font-weight: 700; text-decoration: none; }
</style>
