---
import { PLAYLIST } from '../data/playlist';
---

<section class="music-player" aria-label="Music player" data-music-player transition:persist="music-player">
	<audio class="audio-source" data-audio preload="none"></audio>
	<div class="player-island" data-island>
		<button
			class="play-button"
			type="button"
			aria-label="Play music"
			aria-pressed="false"
			data-play
			disabled={PLAYLIST.length === 0}
		>
			<svg viewBox="0 0 16 16" aria-hidden="true" data-play-icon>
				<path d="M4 2.5v11l9-5.5z" fill="currentColor" />
			</svg>
			<svg viewBox="0 0 16 16" aria-hidden="true" data-pause-icon>
				<path d="M4 3h3v10H4zm5 0h3v10H9z" fill="currentColor" />
			</svg>
		</button>

		<button
			class="track-trigger"
			type="button"
			aria-label="Open playlist"
			aria-expanded="false"
			aria-controls="music-playlist"
			data-trigger
		>
			<span class="track-summary" aria-live="polite">
				<span class="track-title" data-title>{PLAYLIST[0]?.title ?? 'No tracks yet'}</span>
				<span class="track-artist" data-artist>
					{PLAYLIST[0]?.artist ?? 'Add songs to the playlist'}
				</span>
			</span>
		</button>

		<div class="island-controls" data-island-controls aria-label="Playback controls">
			<button type="button" class="control-button" aria-label="Previous track" data-previous disabled>
				<svg viewBox="0 0 16 16" aria-hidden="true">
					<path d="M3 3h2v10H3zm10 0v10L5 8z" fill="currentColor" />
				</svg>
			</button>
			<input
				class="progress-input"
				type="range"
				min="0"
				max="100"
				step="0.1"
				value="0"
				aria-label="Track progress"
				data-progress
				disabled={PLAYLIST.length === 0}
			/>
			<button type="button" class="control-button" aria-label="Next track" data-next disabled>
				<svg viewBox="0 0 16 16" aria-hidden="true">
					<path d="M11 3h2v10h-2zM3 3v10l8-5z" fill="currentColor" />
				</svg>
			</button>
		</div>
	</div>

	<div class="playlist-menu" id="music-playlist" data-menu hidden>
		<div class="playlist-heading">
			<p>Our playlist</p>
			<div class="volume-control">
				<button type="button" class="volume-button" aria-label="Mute" aria-pressed="false" data-volume-toggle>
					<svg class="volume-icon" viewBox="0 0 16 16" aria-hidden="true">
					<path d="M2 6v4h3l4 3V3L5 6zm9-.5a4 4 0 0 1 0 5m1.5-7a7 7 0 0 1 0 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
					<svg class="muted-icon" viewBox="0 0 16 16" aria-hidden="true">
						<path d="M2 6v4h3l4 3V3L5 6zm9 1 4 4m0-4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</button>
				<input
					class="volume-input"
					type="range"
					min="0"
					max="1"
					step="0.01"
					value="0.7"
					aria-label="Volume"
					data-volume
				/>
			</div>
		</div>
		<div class="touch-controls" aria-label="Playback controls">
			<button type="button" class="control-button" aria-label="Previous track" data-menu-previous disabled>
				<svg viewBox="0 0 16 16" aria-hidden="true">
					<path d="M3 3h2v10H3zm10 0v10L5 8z" fill="currentColor" />
				</svg>
			</button>
			<input
				class="progress-input"
				type="range"
				min="0"
				max="100"
				step="0.1"
				value="0"
				aria-label="Track progress"
				data-menu-progress
				disabled={PLAYLIST.length === 0}
			/>
			<button type="button" class="control-button" aria-label="Next track" data-menu-next disabled>
				<svg viewBox="0 0 16 16" aria-hidden="true">
					<path d="M11 3h2v10h-2zM3 3v10l8-5z" fill="currentColor" />
				</svg>
			</button>
		</div>
		<div class="time-labels" aria-hidden="true">
			<span data-current-time>0:00</span>
			<span data-duration>0:00</span>
		</div>
		{PLAYLIST.length > 0 ? (
			<ol class="track-list" aria-label="Playlist">
				{PLAYLIST.map((track) => (
					<li>
						<button
							type="button"
							class="track-choice"
							data-track-id={track.id}
							aria-pressed="false"
						>
							<span class="track-choice-copy">
								<span class="track-choice-title">{track.title}</span>
								<span class="track-choice-artist">{track.artist}</span>
							</span>
							<span class="track-choice-indicator" aria-hidden="true"></span>
						</button>
					</li>
				))}
			</ol>
		) : (
			<p class="empty-playlist">
				Add MP3 files to <code>public/music/</code> and list their titles, artists, and paths in
				<code>src/data/playlist.ts</code>.
			</p>
		)}
		<p class="player-status" role="status" aria-live="polite" data-status></p>
	</div>
</section>

<script>
	import { PLAYLIST } from '../data/playlist';
	import type { PlaylistTrack } from '../data/playlist';

	const initializePlayers = () => {
		document.querySelectorAll<HTMLElement>('[data-music-player]').forEach((player) => {
			if (player.dataset.initialized === 'true') return;
			player.dataset.initialized = 'true';

			const audio = player.querySelector<HTMLAudioElement>('[data-audio]');
			const playButton = player.querySelector<HTMLButtonElement>('[data-play]');
			const trigger = player.querySelector<HTMLButtonElement>('[data-trigger]');
			const menu = player.querySelector<HTMLDivElement>('[data-menu]');
			const title = player.querySelector<HTMLElement>('[data-title]');
			const artist = player.querySelector<HTMLElement>('[data-artist]');
			const progressInputs = [...player.querySelectorAll<HTMLInputElement>('[data-progress], [data-menu-progress]')];
			const currentTime = player.querySelector<HTMLElement>('[data-current-time]');
			const duration = player.querySelector<HTMLElement>('[data-duration]');
			const volume = player.querySelector<HTMLInputElement>('[data-volume]');
			const volumeToggle = player.querySelector<HTMLButtonElement>('[data-volume-toggle]');
			const previousButtons = [...player.querySelectorAll<HTMLButtonElement>('[data-previous], [data-menu-previous]')];
			const nextButtons = [...player.querySelectorAll<HTMLButtonElement>('[data-next], [data-menu-next]')];
			const status = player.querySelector<HTMLElement>('[data-status]');
			const trackButtons = [...player.querySelectorAll<HTMLButtonElement>('[data-track-id]')];

			if (
				!audio || !playButton || !trigger || !menu ||
				!title || !artist || !currentTime || !duration || !volume || !volumeToggle || !status ||
				progressInputs.length === 0 || previousButtons.length === 0 || nextButtons.length === 0
			) {
				throw new Error('Music player markup is incomplete.');
			}

			let selectedId = PLAYLIST[0]?.id ?? '';
			const volumeKey = 'hydrangea-music-volume';
			try {
				const savedVolume = localStorage.getItem(volumeKey);
				if (savedVolume !== null && Number.isFinite(Number(savedVolume))) {
					volume.value = String(Math.min(1, Math.max(0, Number(savedVolume))));
				}
			} catch {
				// The player uses its default volume when storage is unavailable.
			}
			audio.volume = Number(volume.value);
			let lastAudibleVolume = audio.volume || 0.7;
			const getSelectedIndex = () => PLAYLIST.findIndex((track) => track.id === selectedId);

			const updateVolumeToggle = () => {
				const muted = audio.muted || audio.volume === 0;
				volumeToggle.setAttribute('aria-pressed', String(muted));
				volumeToggle.setAttribute('aria-label', muted ? 'Unmute' : 'Mute');
			};

			const saveVolume = () => {
				try {
					localStorage.setItem(volumeKey, volume.value);
				} catch {
					// Volume adjustment remains available for this visit when storage is unavailable.
				}
			};

			const formatTime = (seconds: number) => {
				if (!Number.isFinite(seconds)) return '0:00';
				const minutes = Math.floor(seconds / 60);
				const remainder = Math.floor(seconds % 60).toString().padStart(2, '0');
				return `${minutes}:${remainder}`;
			};

			const updatePlayButton = () => {
				const isPlaying = !audio.paused;
				playButton.setAttribute('aria-label', isPlaying ? 'Pause music' : 'Play music');
				playButton.setAttribute('aria-pressed', String(isPlaying));
			};

			const updateProgress = () => {
				const value =
					Number.isFinite(audio.duration) && audio.duration > 0
						? String((audio.currentTime / audio.duration) * 100)
						: '0';
				progressInputs.forEach((input) => (input.value = value));
				currentTime.textContent = formatTime(audio.currentTime);
				if (Number.isFinite(audio.duration)) duration.textContent = formatTime(audio.duration);
			};

			const updateTrackList = () => {
				trackButtons.forEach((button) => {
					const selected = button.dataset.trackId === selectedId;
					button.setAttribute('aria-pressed', String(selected));
					button.classList.toggle('is-current', selected);
				});
			};

			const setTrack = (track: PlaylistTrack, play = false) => {
				selectedId = track.id;
				audio.pause();
				audio.src = track.src;
				audio.load();
				title.textContent = track.title;
				artist.textContent = track.artist;
				status.textContent = '';
				updateProgress();
				updateTrackList();
				updatePlayButton();
				if (play) {
					void audio.play().catch(() => {
						status.textContent = 'Playback could not start. Check the audio file and try again.';
					});
				}
			};

			const setMenuOpen = (open: boolean) => {
				menu.hidden = !open;
				trigger.setAttribute('aria-expanded', String(open));
				trigger.setAttribute('aria-label', open ? 'Close playlist' : 'Open playlist');
			};

			const moveTrack = (direction: -1 | 1) => {
				const selectedIndex = getSelectedIndex();
				if (selectedIndex < 0 || PLAYLIST.length < 2) return;
				const nextIndex = (selectedIndex + direction + PLAYLIST.length) % PLAYLIST.length;
				const track = PLAYLIST[nextIndex];
				if (track) setTrack(track, true);
			};

			previousButtons.forEach((button) => {
				button.disabled = PLAYLIST.length < 2;
				button.addEventListener('click', () => {
					moveTrack(-1);
					if (button.hasAttribute('data-menu-previous')) setMenuOpen(false);
				});
			});
			nextButtons.forEach((button) => {
				button.disabled = PLAYLIST.length < 2;
				button.addEventListener('click', () => {
					moveTrack(1);
					if (button.hasAttribute('data-menu-next')) setMenuOpen(false);
				});
			});
			progressInputs.forEach((input) => {
				input.addEventListener('input', () => {
					if (Number.isFinite(audio.duration) && audio.duration > 0) {
						audio.currentTime = (Number(input.value) / 100) * audio.duration;
						updateProgress();
					}
				});
				if (input.hasAttribute('data-menu-progress')) {
					input.addEventListener('pointerup', () => {
						setMenuOpen(false);
						input.blur();
					});
				}
			});
			volume.addEventListener('input', () => {
				audio.volume = Number(volume.value);
				if (audio.volume > 0) {
					lastAudibleVolume = audio.volume;
					audio.muted = false;
				}
				updateVolumeToggle();
				saveVolume();
			});
			volumeToggle.addEventListener('click', () => {
				if (audio.muted || audio.volume === 0) {
					audio.muted = false;
					if (audio.volume === 0) {
						audio.volume = lastAudibleVolume;
						volume.value = String(lastAudibleVolume);
						saveVolume();
					}
				} else {
					lastAudibleVolume = audio.volume;
					audio.muted = true;
				}
				updateVolumeToggle();
			});
			playButton.addEventListener('click', () => {
				if (audio.paused) {
					void audio.play().catch(() => {
						status.textContent = 'Playback could not start. Check the audio file and try again.';
					});
				} else {
					audio.pause();
				}
			});
			trigger.addEventListener('click', () => {
				setMenuOpen(menu.hidden);
			});
			trackButtons.forEach((button) => {
				button.addEventListener('click', () => {
					const track = PLAYLIST.find((item) => item.id === button.dataset.trackId);
					if (track) {
						setTrack(track, true);
						setMenuOpen(false);
					}
				});
			});

			audio.addEventListener('play', updatePlayButton);
			audio.addEventListener('pause', updatePlayButton);
			audio.addEventListener('timeupdate', updateProgress);
			audio.addEventListener('loadedmetadata', updateProgress);
			audio.addEventListener('error', () => {
				status.textContent = 'This track could not be loaded. Check its file path and try again.';
				updatePlayButton();
			});
			player.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && !menu.hidden) {
					setMenuOpen(false);
					trigger.focus();
				}
			});
			document.addEventListener('click', (event) => {
				if (!player.contains(event.target as Node)) setMenuOpen(false);
			});

			const initialTrack = PLAYLIST[0];
			if (initialTrack) setTrack(initialTrack);
			updatePlayButton();
			updateVolumeToggle();
		});
	};

	initializePlayers();
	document.addEventListener('astro:page-load', initializePlayers);
</script>

<style>
	.music-player { position: relative; z-index: 20; justify-self: center; width: min(220px, 100%); min-width: 0; transition: width .24s ease; }
	.audio-source { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
	.player-island {
		display: flex;
		min-width: 0;
		align-items: center;
		gap: .5rem;
		padding: .35rem .45rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--surface);
		box-shadow: 0 4px 14px rgb(36 50 39 / 7%);
	}
	.play-button, .control-button {
		display: inline-grid;
		flex: 0 0 auto;
		place-items: center;
		border: 0;
		background: transparent;
		color: var(--accent);
		cursor: pointer;
	}
	.play-button { width: 2rem; height: 2rem; border-radius: 50%; background: var(--accent-soft); }
	.play-button:hover:not(:disabled) { background: var(--accent); color: var(--accent-ink); }
	.play-button:disabled, .control-button:disabled { cursor: not-allowed; opacity: .48; }
	.play-button svg, .control-button svg { display: block; width: 1rem; height: 1rem; }
	.play-button[aria-pressed='false'] [data-pause-icon],
	.play-button[aria-pressed='true'] [data-play-icon] { display: none; }
	.track-trigger { display: block; flex: 1; min-width: 0; padding: 0; border: 0; background: transparent; color: inherit; cursor: pointer; text-align: left; }
	.track-summary { display: grid; min-width: 0; line-height: 1.2; }
	.track-title, .track-artist { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.track-title { color: var(--text); font-size: .78rem; font-weight: 700; }
	.track-artist { color: var(--text-muted); font-size: .68rem; }
	.island-controls {
		display: none;
		flex: 0 0 0;
		align-items: center;
		gap: .35rem;
		min-width: 0;
		opacity: 0;
		transition: opacity .16s ease;
	}
	.control-button { width: 1.7rem; height: 1.7rem; border-radius: 50%; color: var(--text-muted); }
	.control-button:hover:not(:disabled) { background: var(--accent-soft); color: var(--accent); }
	.progress-input { flex: 1; min-width: 2.5rem; width: 100%; margin: 0; accent-color: var(--accent); cursor: pointer; }
	.progress-input:disabled { cursor: not-allowed; opacity: .5; }
	.playlist-menu {
		position: absolute;
		top: calc(100% + .5rem);
		left: 50%;
		z-index: 30;
		width: min(320px, calc(100vw - 2rem));
		padding: .85rem;
		border: 1px solid var(--line);
		border-radius: 1rem;
		background: var(--surface);
		box-shadow: var(--box-shadow);
		transform: translateX(-50%);
	}
	.playlist-menu[hidden] { display: none; }
	.playlist-heading { display: flex; align-items: center; justify-content: space-between; gap: .75rem; margin: 0 0 .45rem; color: var(--text-muted); font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
	.playlist-heading > p { margin: 0; }
	.volume-control { display: flex; flex: 0 0 7rem; align-items: center; gap: .4rem; }
	.volume-button { display: inline-grid; flex: 0 0 1.15rem; width: 1.15rem; height: 1.5rem; place-items: center; padding: 0; border: 0; background: transparent; color: var(--text-muted); cursor: pointer; transform: translateY(-2px); }
	.volume-button:hover { color: var(--accent); }
	.volume-button svg { display: block; width: 1rem; height: 1rem; }
	.volume-button[aria-pressed='false'] .muted-icon,
	.volume-button[aria-pressed='true'] .volume-icon { display: none; }
	.volume-input { width: 100%; min-width: 0; margin: 0; accent-color: var(--accent); cursor: pointer; transform: translateY(-2px); }
	.touch-controls { display: none; align-items: center; gap: .45rem; }
	.time-labels { display: flex; justify-content: space-between; color: var(--text-muted); font-size: .65rem; line-height: 1.5; }
	.track-list { max-height: 13rem; overflow: auto; margin: .4rem 0 0; padding: 0; border-top: 1px solid var(--line); list-style: none; }
	.track-list li + li { border-top: 1px solid var(--line); }
	.track-choice { display: flex; width: 100%; align-items: center; gap: .5rem; padding: .6rem .4rem; border: 0; background: transparent; color: var(--text); cursor: pointer; font: inherit; text-align: left; }
	.track-choice:hover, .track-choice.is-current { color: var(--accent); }
	.track-choice-copy { display: grid; flex: 1; min-width: 0; line-height: 1.3; }
	.track-choice-title, .track-choice-artist { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.track-choice-title { font-size: .78rem; font-weight: 700; }
	.track-choice-artist { color: var(--text-muted); font-size: .68rem; }
	.track-choice-indicator { width: .45rem; height: .45rem; border-radius: 50%; background: transparent; }
	.track-choice.is-current .track-choice-indicator { background: var(--accent); }
	.empty-playlist { margin: .65rem 0 0; padding: .65rem; border-radius: .65rem; background: var(--page); color: var(--text-muted); font-size: .75rem; line-height: 1.5; }
	.empty-playlist code { color: var(--text); font-size: .7rem; }
	.player-status { margin: .4rem 0 0; color: var(--accent); font-size: .7rem; }
	.player-status:empty { display: none; }
	@media (hover: hover) and (pointer: fine) {
		.music-player:hover, .music-player:has(:focus-visible) { width: min(390px, calc(100vw - 2rem)); }
		.music-player:hover .island-controls, .music-player:has(:focus-visible) .island-controls {
			display: flex;
			flex: 1 1 0;
			opacity: 1;
		}
	}
	@media (max-width: 920px) {
		.music-player, .music-player:hover, .music-player:has(:focus-visible) { width: min(220px, 100%); }
		.island-controls { display: none; }
		.playlist-menu { left: 50%; width: min(320px, calc(100vw - 2rem)); transform: translateX(-50%); }
		.touch-controls { display: flex; }
	}
</style>
