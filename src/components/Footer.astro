---
import { SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<p>Made with love by {SITE_TITLE}.</p>
	<p>© {year} · A journal of our journey toward marriage</p>
</footer>

<style>
	footer { padding: 2.5rem 1rem; border-top: 1px solid var(--line); color: var(--text-muted); text-align: center; }
	footer p { margin: .2rem 0; font-size: .83rem; }
	footer p:first-child { color: var(--text); font-family: var(--font-serif); font-size: 1.1rem; }
</style>
